# Compose-level settings only.
# Runtime anomaly parameters live in config/containers/jetson_anomaly.env,
# matching the robot stack's config/containers/*.env layout.

JETSON_LOG_VIEWER_PORT=8081

# JetPack 6 / CUDA 12.6 build defaults for YOLO inference.
L4T_BASE=nvcr.io/nvidia/l4t-jetpack:r36.4.0
PYTORCH_INDEX_URL=https://pypi.jetson-ai-lab.io/jp6/cu126/+simple/
TORCH_VERSION=2.8.0
TORCHVISION_VERSION=0.23.0
ULTRALYTICS_VERSION=8.3.40
