# Jetson anomaly client runtime parameters.
# This file is loaded by docker-compose.yaml through env_file, matching the
# robot stack's config/containers/*.env layout.

ANOMALY_CONFIG_FILE=/workspace/config/anomaly_rosbridge.yaml
ROSBRIDGE_URL=ws://raspberry.local:9090

CAMERA_TOPIC=/camera/color/image/compressed
MAP_TOPIC=/map
ROBOT_POSE_TOPIC=/robot_pose_map
SCAN_TOPIC=/scan
DEPTH_TOPIC=/camera/realsense/aligned_depth_to_color/image_raw
CAMERA_INFO_TOPIC=/camera/realsense/color/camera_info

EVENT_TOPIC=/anomaly/events
READABLE_EVENT_TOPIC=/anomaly/events/readable
MARKER_TOPIC=/anomaly/markers
DETECTION_3D_TOPIC=/anomaly/detections_3d
# Leave empty to reuse the RGB image header frame (normally color optical frame).
DETECTION_3D_FRAME_ID=
DEBUG_IMAGE_TOPIC=/anomaly/debug_image/compressed
PRIVACY_IMAGE_TOPIC=/anomaly/privacy_image/compressed
INSPECTION_REQUEST_TOPIC=/anomaly/inspection/request
INSPECTION_STATUS_TOPIC=/anomaly/inspection/status
INSPECTION_RESULT_TOPIC=/anomaly/inspection/result
INSPECTION_PRIVACY_IMAGE_TOPIC=/anomaly/inspection/privacy_image/compressed
MAP_SNAPSHOT_TOPIC=/anomaly/map_snapshot/compressed

JETSON_ARTIFACT_ROOT=/home/jetson/anomaly_logs
JETSON_LOG_DIR=/workspace/logs

ANOMALY_CLASSES=bottle
CONFIDENCE_THRESHOLD=0.5
DETECTION_COOLDOWN_S=5
MARKER_TTL_S=180
MARKER_REPUBLISH_HZ=1
CLUSTER_MERGE_RADIUS_M=0.25
MARKER_ASSOCIATION_RADIUS_M=0.40
REPORTED_MERGE_RADIUS_M=1.00
TRACK_REASSOCIATION_RADIUS_M=1.00
TRACK_REASSOCIATION_RAY_TOLERANCE_M=0.35
MARKER_MAX_FAR_JUMP_M=0.60
ANOMALY_MIN_OBSERVATIONS=2
ANOMALY_CONFIRMATION_TTL_S=6.0
MARKER_OBJECT_SIZE_M=0.20
MARKER_TEXT_HEIGHT_M=0.08
MARKER_TEXT_Z_OFFSET_M=0.18
MARKER_TEXT_SHOW_COUNT=0
MARKER_TEXT_COMPACT=1
TRACKED_OBJECT_MIN_SEPARATION_M=0.01
DEFAULT_ANOMALY_DISTANCE_M=1.5
CAMERA_HORIZONTAL_FOV_DEG=69
CAMERA_YAW_OFFSET_DEG=0
USE_CAMERA_INTRINSICS=1
USE_DEPTH_DISTANCE=1
DEPTH_THROTTLE_MS=200
DEPTH_MAX_AGE_S=1.0
DEPTH_SYNC_TOLERANCE_S=0.25
DEPTH_BUFFER_SIZE=8
DEPTH_ROI_SCALE=0.60
DEPTH_MIN_VALID_PIXELS=20
DEPTH_DISTANCE_PERCENTILE=50.0
DEPTH_MIN_DISTANCE_M=0.15
DEPTH_MAX_DISTANCE_M=6.0
DEPTH_TRACK_FILTER_ENABLED=1
DEPTH_TRACK_MAX_FAR_JUMP_M=0.60
DEPTH_TRACK_FILTER_TTL_S=3.0
DEFAULT_DISTANCE_UNCERTAINTY_M=0.75
USE_LASER_DISTANCE=1
LASER_WINDOW_DEG=6
LASER_MIN_DISTANCE_M=0.10
LASER_MAX_DISTANCE_M=4.0
LASER_DISTANCE_UNCERTAINTY_M=0.10
YOLO_MODEL_PATH=yolov8n-seg.pt
YOLO_IMAGE_SIZE=640
YOLO_IOU_THRESHOLD=0.70
YOLO_MAX_DETECTIONS=20
YOLO_DEVICE=0
YOLO_HALF=1
YOLO_AUGMENT=0
YOLO_AGNOSTIC_NMS=0
YOLO_FILTER_CLASSES=1
TRACKING_ENABLED=1
TRACKING_BACKEND=bytetrack.yaml
TRACKING_CONFIDENCE_THRESHOLD=0.25
SEGMENTATION_ENABLED=1
SEGMENTATION_DEPTH_MASK_ERODE_PX=2
MOCK_MODE=0
SAVE_PER_EVENT_IMAGES=1
SAVE_ANNOTATED_PRIVACY_BLUR=1
SAVE_DOCUMENTATION_IMAGES=1
DAILY_MAP_SUMMARY=1
DAILY_MAP_SUMMARY_TOPIC_PUBLISH=1
DEBUG_IMAGE_ALWAYS_STREAM=1
DEBUG_IMAGE_ON_DETECTION=1
DEBUG_IMAGE_PUBLISH_HZ=2
PRIVACY_IMAGE_ENABLED=1
PRIVACY_IMAGE_PUBLISH_HZ=2
PRIVACY_BLUR_KERNEL_SIZE=101
PRIVACY_BBOX_PADDING_RATIO=0.03
PRIVACY_USE_SEGMENTATION_MASKS=1
PRIVACY_DRAW_TRACK_ID=1
PRIVACY_DRAW_MASK_OVERLAY=1
PRIVACY_MASK_OVERLAY_ALPHA=0.25
INSPECTION_ENABLED=0
INSPECTION_STANDOFF_M=0.70
INSPECTION_MIN_DISTANCE_M=0.40
INSPECTION_MAX_DISTANCE_M=3.0
INSPECTION_MAX_UNCERTAINTY_M=0.30
INSPECTION_REQUIRE_METRIC_DISTANCE=1
INSPECTION_CAPTURE_FRAMES=8
INSPECTION_CAPTURE_TIMEOUT_S=8.0
INSPECTION_REQUEST_TIMEOUT_S=70.0
INSPECTION_JPEG_QUALITY=95
INSPECTION_ONCE_PER_CLUSTER=1
INSPECTION_RETRY_COOLDOWN_S=60.0
INSPECTION_GROUP_ENABLED=1
INSPECTION_GROUP_RADIUS_M=2.0
INSPECTION_GROUP_COLLECTION_S=0.75
INSPECTION_GROUP_MIN_OBJECTS=2
INSPECTION_GROUP_MAX_OBJECTS=10
INSPECTION_GROUP_FOV_MARGIN_RATIO=1.25
INSPECTION_GROUP_MAX_STANDOFF_M=2.50
INSPECTION_GROUP_REQUIRE_ALL_VISIBLE=1
EVALUATION_METRICS_ENABLED=1
EVALUATION_METRICS_SAMPLE_PERIOD_S=1.0
MARKER_RAY_ENABLED=1
MARKER_RAY_TTL_S=2.0
MARKER_UNCERTAINTY_ENABLED=1
MARKER_UNCERTAINTY_SIGMA_SCALE=2.0
MARKER_UNCERTAINTY_MIN_RADIUS_M=0.05
MARKER_UNCERTAINTY_MAX_RADIUS_M=1.0
MARKER_AUX_LINE_WIDTH_M=0.025
DETECTION_3D_ENABLED=1
DETECTION_3D_REQUIRE_MASK=1
DETECTION_3D_PUBLISH_HZ=5.0
DETECTION_3D_TTL_S=0.75
DETECTION_3D_MIN_VALID_POINTS=30
DETECTION_3D_LOWER_PERCENTILE=5.0
DETECTION_3D_UPPER_PERCENTILE=95.0
DETECTION_3D_SAMPLE_STRIDE=2
DETECTION_3D_MINIMUM_THICKNESS_M=0.05
DETECTION_3D_LINE_WIDTH_M=0.01
DETECTION_3D_TEXT_ENABLED=1
DETECTION_3D_TEXT_HEIGHT_M=0.035
DETECTION_3D_TEXT_SHOW_LABEL=0
DETECTION_3D_TEXT_SHOW_CONFIDENCE=0
DETECTION_3D_TEXT_SHOW_DISTANCE=1

NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility,video
